+static auto GetEraScaledMultiplier(uint8 level, float startValue, float endValue) -> float
+{
+    if (level < 37)
+    {
+        return startValue;
+    }
+    else if (level >= 75)
+    {
+        return endValue;
+    }
+
+    return startValue + (endValue - startValue) * ((level - 37) / 38.0f);
+}
