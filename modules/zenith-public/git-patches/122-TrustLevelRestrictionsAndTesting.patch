+auto trustutils::canUseAbility(CTrustEntity* PTrust, CAbility* PAbility) -> bool
+{
+    if (PTrust == nullptr || PAbility == nullptr)
+    {
+        return false;
+    }
+
+    if (PAbility->getJob() == PTrust->GetMJob())
+    {
+        return PTrust->GetMLevel() >= PAbility->getLevel();
+    }
+
+    if (PTrust->GetSJob() != xi::Job::NONE && PAbility->getJob() == PTrust->GetSJob())
+    {
+        return PTrust->GetSLevel() >= PAbility->getLevel() && !(PAbility->getAddType() & ADDTYPE_MAIN_ONLY);
+    }
+
+    // Not one of the Trust's jobs: a deliberate Trust-specific action, not level-gated here.
+    return true;
+}
+
+auto trustutils::canUseAbility(CTrustEntity* PTrust, uint16 abilityId) -> bool
+{
+    return canUseAbility(PTrust, ability::GetAbility(abilityId));
+}
+
+auto trustutils::meetsWeaponskillRequirement(CTrustEntity* PTrust, uint16 weaponskillId) -> bool
+{
+    CWeaponSkill* PWeaponSkill = PTrust ? battleutils::GetWeaponSkill(weaponskillId) : nullptr;
+    if (PWeaponSkill == nullptr)
+    {
+        return false;
+    }
+
+    const auto skillType = static_cast<xi::SkillType>(PWeaponSkill->getType());
+    const auto level     = std::min<uint8>(PTrust->GetMLevel(), 99);
+    uint16     skill     = battleutils::GetMaxSkill(skillType, PTrust->GetMJob(), level);
+
+    // A Trust whose main job has no rank in this weapon falls back to its own working skill.
+    if (skill == 0)
+    {
+        skill = PTrust->GetSkill(skillType);
+    }
+
+    return skill >= PWeaponSkill->getSkillLevel();
+}
