+// Used in Gambits: the mirror of GetBestAvailable. Spell lists load ORDER BY min_level,
+// so the first castable match is the lowest tier.
+auto CMobSpellContainer::GetWorstAvailable(SPELLFAMILY family) -> Maybe<SpellID>
+{
+    auto searchInList = [&](const std::vector<SpellID>& list) -> Maybe<SpellID>
+    {
+        for (const auto id : list)
+        {
+            const bool sameFamily = family == SPELLFAMILY_NONE || spell::GetSpell(id)->getSpellFamily() == family;
+            if (sameFamily && GetAvailable(id))
+            {
+                return id;
+            }
+        }
+
+        return std::nullopt;
+    };
+
+    if (family == SPELLFAMILY_NONE)
+    {
+        return searchInList(m_damageList);
+    }
+
+    for (const auto* list : { &m_gaList, &m_damageList, &m_buffList, &m_debuffList, &m_healList, &m_naList, &m_raiseList })
+    {
+        if (auto spellId = searchInList(*list))
+        {
+            return spellId;
+        }
+    }
+
+    return std::nullopt;
+}
