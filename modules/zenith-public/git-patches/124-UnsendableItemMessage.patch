Tell the player why an item cannot be put in the delivery box.

AddItemsToBeSent returned without a reply when an item's NoDelivery flag
blocked the send (no CanSendAccount, or a recipient on another account).
The client then waited until it timed out with a congestion error. Both
cases now answer the Set with NOT_POSTABLE_ITEM (0xBB) and print a
system message giving the reason. The unsendable_items SQL makes many
items hit the first case, while the client DAT still allows them.
---
diff --git a/src/map/utils/dboxutils.cpp b/src/map/utils/dboxutils.cpp
index eb2daf31dc..35dfd7aa25 100644
--- a/src/map/utils/dboxutils.cpp
+++ b/src/map/utils/dboxutils.cpp
@@ -27,6 +27,7 @@
 
 #include "ai/ai_container.h"
 #include "entities/char_entity.h"
+#include "enums/chat_message_type.h"
 #include "enums/msg_std.h"
 
 #include "items.h"
@@ -36,6 +37,7 @@
 
 #include "packets/c2s/0x04d_pbx.h"
 #include "packets/s2c/0x009_message.h"
+#include "packets/s2c/0x017_chat_std.h"
 #include "packets/s2c/0x01d_item_same.h"
 #include "packets/s2c/0x04b_pbx_result.h"
 #include "universal_container.h"
@@ -51,6 +53,13 @@ auto isDeliveryBoxInflightAtCapacity(uint32 charid) -> bool
     return rset && rset->next() && rset->get<uint32>("cnt") >= maxInflight;
 }
 
+// Answers the Set so the client does not wait for a reply until it times out, and says why
+void rejectUnpostableItem(CCharEntity* PChar, GP_CLI_COMMAND_PBX_BOXNO BoxNo, CItem* PItem, int8_t PostWorkNo, const std::string& reason)
+{
+    PChar->pushPacket<GP_SERV_COMMAND_PBX_RESULT>(GP_CLI_COMMAND_PBX_COMMAND::Set, BoxNo, PItem, PostWorkNo, PChar->UContainer->GetItemsCount(), 0xBB); // NOT_POSTABLE_ITEM
+    PChar->pushPacket<GP_SERV_COMMAND_CHAT_STD>(PChar, CHAT_MESSAGE_TYPE::MESSAGE_SYSTEM_1, reason);
+}
+
 } // anonymous namespace
 
 void dboxutils::SendOldItems(CCharEntity* PChar, GP_CLI_COMMAND_PBX_BOXNO BoxNo)
@@ -170,12 +179,14 @@ void dboxutils::AddItemsToBeSent(CCharEntity* PChar, GP_CLI_COMMAND_PBX_BOXNO Bo
             {
                 if (!PItem->hasFlag(xi::ItemFlag::CanSendAccount))
                 {
+                    rejectUnpostableItem(PChar, BoxNo, PItem, PostWorkNo, "That item cannot be sent to anyone, including your other characters.");
                     return;
                 }
 
                 // Different accounts
                 if (PChar->accid != recvAccid)
                 {
+                    rejectUnpostableItem(PChar, BoxNo, PItem, PostWorkNo, "That item can only be sent to characters on your own account.");
                     return;
                 }
             }
